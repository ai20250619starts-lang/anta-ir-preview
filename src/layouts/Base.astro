---
/**
 * Page shell: <html lang>, noindex, hreflang alternates, self-hosted font preload, light password gate,
 * skip link, PREVIEW banner, header, <main id="main">, footer.
 */
import '../styles/global.css';
import type { Lang } from '../data/schemas';
import { HTML_LANG, LANGS, t } from '../i18n/ui';
import { withBase } from '../lib/paths';
import { switchLangPath } from '../lib/i18n-path';
import PasswordGate from '../components/PasswordGate.astro';
import PasswordGateForm from '../components/PasswordGateForm.astro';
import PreviewBanner from '../components/PreviewBanner.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import interLatin from '../assets/fonts/inter-latin-wght-normal.woff2?url';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  /** legacy prop from piece 1 pages; the switcher now derives the path from the URL */
  path?: string;
}
const { lang, title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
const abs = (p: string) => new URL(p, Astro.site).href;
const desc = description ?? t(lang, 'heroBody');
---
<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Preview must never be indexed (GitHub Pages cannot send X-Robots-Tag headers, so this meta is the main control). -->
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <PasswordGate />
    <title>{title} · {t(lang, 'siteTitle')}</title>
    <meta name="description" content={desc} />
    <meta name="theme-color" content="#111111" />
    <meta property="og:title" content={`${title} · ${t(lang, 'siteName')}`} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <link rel="icon" href={withBase('assets/anta/favicon.png')} />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    {LANGS.map((l) => <link rel="alternate" hreflang={HTML_LANG[l]} href={abs(switchLangPath(Astro.url.pathname, base, l))} />)}
    <link rel="alternate" hreflang="x-default" href={abs(switchLangPath(Astro.url.pathname, base, 'en'))} />
  </head>
  <body class="flex min-h-screen flex-col bg-white text-ink">
    <PasswordGateForm />
    <a href="#main" class="sr-only-focusable absolute top-2 left-2 z-[60] rounded-sm bg-ink px-4 py-3 font-semibold text-white">{t(lang, 'skip')}</a>
    <PreviewBanner lang={lang} />
    <SiteHeader lang={lang} />
    <main id="main" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>
    <SiteFooter lang={lang} />
    <script>
      // Mobile menu disclosure
      const btn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
      const panel = document.getElementById('mobile-nav');
      if (btn && panel) {
        const set = (open: boolean) => {
          btn.setAttribute('aria-expanded', String(open));
          panel.hidden = !open;
          btn.querySelector('.menu-open-icon')?.classList.toggle('hidden', open);
          btn.querySelector('.menu-close-icon')?.classList.toggle('hidden', !open);
        };
        btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
            set(false);
            btn.focus();
          }
        });
      }
      // Language switcher keeps query string and #anchor
      document.querySelectorAll<HTMLAnchorElement>('a[data-lang-switch]').forEach((a) => {
        a.addEventListener('click', () => {
          const u = new URL(a.href);
          u.search = location.search;
          u.hash = location.hash;
          a.href = u.href;
        });
      });
    </script>
  </body>
</html>
