---
/**
 * Home page (EN / TC / SC) — "Lane Lines" concept (design/DESIGN.md). Order: hero (+ quote card), latest results band,
 * Why Invest, announcements, financial highlights, events + stay informed, brands, ESG. Motion: see global.css + Base.astro.
 */
import Base from '../../layouts/Base.astro';
import type { Lang } from '../../data/schemas';
import { calendar, company, contacts, documents, highlights } from '../../data';
import { langPaths, pick, t } from '../../i18n/ui';
import { withBase } from '../../lib/paths';
import { buildResultsPeriods, latestResults } from '../../lib/results';
import QuoteStrip from '../../components/QuoteStrip.astro';
import ResultsHubCard from '../../components/ResultsHubCard.astro';
import DocumentRow from '../../components/DocumentRow.astro';
import KpiCard from '../../components/KpiCard.astro';
import CalendarItem from '../../components/CalendarItem.astro';
import ContactCard from '../../components/ContactCard.astro';
import BrandStrip from '../../components/BrandStrip.astro';
import WhyInvest from '../../components/WhyInvest.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Lanes from '../../components/ui/Lanes.astro';
import Button from '../../components/ui/Button.astro';
import { Image } from 'astro:assets';
import esgImage from '../../assets/images/banner3.jpg';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const href = (p: string) => withBase(`${lang}/${p}`);

const period = latestResults(buildResultsPeriods(documents.documents));
const announcements = documents.documents.filter((d) => d.tags.includes('list:announcements') && d.dateSource === 'listing').slice(0, 5);
const KPI_KEYS = ['revenue', 'profit-attributable-to-equity-shareholders', 'gross-profit-margin', 'basic-earnings-per-share'];
const kpis = KPI_KEYS.map((k) => highlights.rows.find((r) => r.key === k)).filter((r): r is NonNullable<typeof r> => !!r);
const kpiLabels: Record<string, Record<Lang, string>> = {
  'profit-attributable-to-equity-shareholders': { en: 'Profit attributable to shareholders', tc: '股東應佔溢利', sc: '股东应占溢利' },
  'basic-earnings-per-share': { en: 'Basic EPS', tc: '每股基本盈利', sc: '每股基本盈利' },
};
// "today" in HKT at build time
const today = new Date(Date.now() + 8 * 3600e3).toISOString().slice(0, 10);
const events = [...calendar.events].sort((a, b) => a.date.localeCompare(b.date));
const upcoming = events.filter((e) => e.date >= today).slice(0, 3);
const recent = upcoming.length ? [] : events.filter((e) => e.date < today).reverse().slice(0, 3);
const hk = contacts.offices.find((o) => o.key === 'hong-kong-sar') ?? contacts.offices[0];
const irEmails = contacts.emails.map((e) => ({ label: pick(e.label, lang), email: e.email }));
const alertUrl = contacts.vendorForms.emailAlertUrl[lang];
const esgUrl = company.esg.siteUrl[lang] ?? company.esg.siteUrl.en;
const esgReports = company.esg.reportsUrl[lang] ?? company.esg.reportsUrl.en;
// Headline phrases kept together (DESIGN.md: no orphaned "multi-" / CJK characters): EN nowrap on "multi-brand",
// CJK split after "、" into inline-block phrases.
const heroTitle = t(lang, 'heroTitle');
// Word spans for the H1 "lean-in" (MOTION.md §3): EN words / CJK phrases (split after 、), each .ll-w with --i.
const titleParts = lang === 'en' ? heroTitle.split(' ') : heroTitle.split(/(?<=、)/);
---
<Base lang={lang} title={t(lang, 'home')}>
  <!-- 1–2 Hero with quote card -->
  <section class="ll-hero on-dark relative isolate overflow-clip bg-ink text-white" aria-labelledby="h-hero">
    <Lanes />
    <div class="container-page grid gap-10 pt-11 pb-[120px] lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:items-start lg:gap-16 lg:pt-20 lg:pb-[168px]">
      <div>
        <p class="eyebrow ll-eyebrow !text-on-dark-muted">{t(lang, 'heroEyebrow')}</p>
        <h1 id="h-hero" class="mt-5 text-display font-[650] tracking-[-0.032em] text-balance md:text-display-md lg:text-display-lg">{titleParts.map((p, i) => <><span class="ll-w" style={`--i:${i}`}>{p}</span>{lang === 'en' && i < titleParts.length - 1 ? ' ' : ''}</>)}</h1>
        <p class="ll-body-in mt-5 max-w-[40em] text-lg text-hero-body lg:text-xl">{t(lang, 'heroBody')}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href="#results" icon="arrow-right" class="ll-cta ll-magnet" style="--d:350ms">{t(lang, 'latestResults')}</Button>
          <Button href="#why" variant="inverse" icon={null} class="ll-cta ll-magnet" style="--d:410ms">{t(lang, 'whyInvestCta')}</Button>
        </div>
        <p class="ll-slogan ll-slogan-in mt-10 text-[1.375rem]">{pick(company.slogan, lang)}</p>
      </div>
      <div class="ll-quote-in"><QuoteStrip lang={lang} /></div>
    </div>
  </section>

  <!-- 3 Latest results band (overlaps the hero; the red lane arrives at its top edge) -->
  <section id="results" class="relative z-10 -mt-20 scroll-mt-24" aria-label={t(lang, 'latestResults')}>
    <div class="container-page"><ResultsHubCard period={period} lang={lang} feature headingLevel="h2" /></div>
  </section>

  <!-- 4 Why Invest (client-confirmed) -->
  <WhyInvest lang={lang} />

  <!-- 5 Latest announcements -->
  <section class="pb-section lg:pb-section-lg" aria-labelledby="h-ann" data-reveal>
    <div class="container-page">
      <SectionHeading id="h-ann" eyebrow={t(lang, 'filings')} title={t(lang, 'latestAnnouncements')} action={{ href: href('investors/announcements/'), label: t(lang, 'allAnnouncements') }} />
      <div>
        <div class="ll-rule" data-enter style="--kf:ll-scale-x" aria-hidden="true"></div>
        {announcements.map((d, i) => <DocumentRow doc={d} lang={lang} headingLevel="h3" i={i + 1} />)}
      </div>
    </div>
  </section>

  <!-- 6 Financial highlights -->
  <section class="bg-surface py-section lg:py-section-lg" aria-labelledby="h-fin" data-reveal>
    <div class="container-page">
      <SectionHeading id="h-fin" eyebrow={`${t(lang, 'annualResults')} · ${t(lang, 'fy')}${lang === 'en' ? ' ' : ''}${highlights.years[0]}`} title={t(lang, 'financialHighlights')} description={`${pick(highlights.currencyNote, lang)} · ${t(lang, 'sixYearTrend')} ${Math.min(...highlights.years)}–${highlights.years[0]}`} action={{ href: href('investors/highlights/'), label: t(lang, 'allHighlights') }} />
      <div class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4 lg:gap-5">
        {kpis.map((r, i) => <KpiCard index={i} row={r} years={highlights.years} lang={lang} label={kpiLabels[r.key]?.[lang]} />)}
      </div>
    </div>
  </section>

  <!-- 7 Events + stay informed -->
  <section class="py-section lg:py-section-lg" data-reveal>
    <div class="container-page grid gap-12 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-16">
      <div aria-labelledby="h-ev">
        <SectionHeading id="h-ev" eyebrow={t(lang, 'irCalendar')} title={upcoming.length ? t(lang, 'upcomingEvents') : t(lang, 'recentEvents')} action={{ href: href('investors/'), label: t(lang, 'irCalendar') }} />
        {!upcoming.length && <p class="-mt-3 mb-4 text-sm text-muted">{t(lang, 'noUpcoming')}</p>}
        <div class="border-t-2 border-ink">
          {(upcoming.length ? upcoming : recent).map((e, i) => <CalendarItem event={e} lang={lang} past={!upcoming.length} i={i} />)}
        </div>
      </div>
      <aside aria-labelledby="h-cta" data-enter style="--kf:ll-slide-r;--from-x:40px" class="ll-stay relative self-start overflow-clip rounded-lg bg-surface p-7 lg:p-9">
        <h2 id="h-cta" class="text-2xl font-[650] tracking-[-0.02em]">{t(lang, 'stayInformed')}</h2>
        <p class="mt-2 text-graphite">{t(lang, 'stayInformedBody')}</p>
        <div class="mt-5 flex flex-wrap gap-3">
          <Button href={alertUrl} external icon="bell" srSuffix={t(lang, 'externalSite')}>{t(lang, 'emailAlerts')}</Button>
          <Button href={href('contact/')} variant="secondary">{t(lang, 'contactIr')}</Button>
        </div>
        <div class="mt-7 border-t border-line pt-6">
          <ContactCard plain lang={lang} title={pick(hk.name, lang)} address={pick(hk.address, lang)} phones={hk.phones} fax={hk.fax} emails={irEmails} />
        </div>
      </aside>
    </div>
  </section>

  <!-- 8 Brands -->
  <section class="bg-surface py-section lg:py-section-lg" aria-labelledby="h-br" data-reveal>
    <div class="container-page">
      <SectionHeading id="h-br" eyebrow={t(lang, 'multiBrand')} title={t(lang, 'ourBrands')} action={{ href: href('brands/'), label: t(lang, 'brandPortfolio') }} />
      <BrandStrip lang={lang} />
    </div>
  </section>

  <!-- 9 ESG -->
  <section class="py-section lg:py-section-lg" aria-labelledby="h-esg" data-reveal>
    <div class="container-page grid items-center gap-9 lg:grid-cols-2 lg:gap-20">
      <div class="ll-curtain rounded-lg"><Image src={esgImage} alt="" widths={[480, 768, 1080]} sizes="(min-width: 1024px) 50vw, 100vw" class="block aspect-[4/3] w-full object-cover" loading="lazy" /></div>
      <div data-enter style="--i:2">
        <p class="eyebrow ll-eyebrow ll-eb">ESG</p>
        <h2 id="h-esg" class="mt-3 text-3xl font-[650] tracking-[-0.022em] lg:text-4xl">{t(lang, 'esgTitle')}</h2>
        <p class="mt-4 text-lg text-graphite lg:text-xl">{t(lang, 'esgBody')}</p>
        <div class="mt-7 flex flex-wrap gap-3">
          <Button href={esgUrl} variant="ink" external srSuffix={t(lang, 'externalSite')}>{t(lang, 'visitEsg')}</Button>
          <Button href={esgReports} variant="secondary" external srSuffix={t(lang, 'externalSite')}>{t(lang, 'esgReports')}</Button>
        </div>
      </div>
    </div>
  </section>
</Base>
