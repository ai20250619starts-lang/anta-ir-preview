---
/** Home page (EN / TC / SC): IR-first above the fold, then Why Invest (draft), announcements, highlights, events, brands, ESG, CTA. */
import Base from '../../layouts/Base.astro';
import type { Lang } from '../../data/schemas';
import { calendar, company, contacts, documents, highlights } from '../../data';
import { langPaths, pick, t } from '../../i18n/ui';
import { withBase } from '../../lib/paths';
import { buildResultsPeriods, latestResults } from '../../lib/results';
import QuoteStrip from '../../components/QuoteStrip.astro';
import ResultsHubCard from '../../components/ResultsHubCard.astro';
import DocumentRow from '../../components/DocumentRow.astro';
import KpiCard from '../../components/KpiCard.astro';
import CalendarItem from '../../components/CalendarItem.astro';
import ContactCard from '../../components/ContactCard.astro';
import BrandStrip from '../../components/BrandStrip.astro';
import WhyInvest from '../../components/WhyInvest.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Button from '../../components/ui/Button.astro';
import { Image } from 'astro:assets';
import esgImage from '../../assets/images/banner3.jpg';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const href = (p: string) => withBase(`${lang}/${p}`);

const period = latestResults(buildResultsPeriods(documents.documents));
const announcements = documents.documents.filter((d) => d.tags.includes('list:announcements') && d.dateSource === 'listing').slice(0, 5);
const KPI_KEYS = ['revenue', 'profit-attributable-to-equity-shareholders', 'gross-profit-margin', 'basic-earnings-per-share'];
const kpis = KPI_KEYS.map((k) => highlights.rows.find((r) => r.key === k)).filter((r): r is NonNullable<typeof r> => !!r);
const kpiLabels: Record<string, Record<Lang, string>> = {
  'profit-attributable-to-equity-shareholders': { en: 'Profit attributable to shareholders', tc: '股東應佔溢利', sc: '股东应占溢利' },
  'basic-earnings-per-share': { en: 'Basic EPS', tc: '每股基本盈利', sc: '每股基本盈利' },
};
// "today" in HKT at build time
const today = new Date(Date.now() + 8 * 3600e3).toISOString().slice(0, 10);
const events = [...calendar.events].sort((a, b) => a.date.localeCompare(b.date));
const upcoming = events.filter((e) => e.date >= today).slice(0, 3);
const recent = upcoming.length ? [] : events.filter((e) => e.date < today).reverse().slice(0, 3);
const hk = contacts.offices.find((o) => o.key === 'hong-kong-sar') ?? contacts.offices[0];
const irEmails = contacts.emails.map((e) => ({ label: pick(e.label, lang), email: e.email }));
const alertUrl = contacts.vendorForms.emailAlertUrl[lang];
const esgUrl = company.esg.siteUrl[lang] ?? company.esg.siteUrl.en;
const esgReports = company.esg.reportsUrl[lang] ?? company.esg.reportsUrl.en;
---
<Base lang={lang} title={t(lang, 'home')}>
  <!-- Above the fold: headline, quote, latest results -->
  <section class="border-b border-mist bg-paper">
    <div class="container-page grid gap-8 py-8 md:py-12 lg:grid-cols-[1.15fr_1fr] lg:gap-12">
      <div class="flex flex-col gap-6">
        <div>
          <p class="eyebrow flex items-center gap-2"><span class="inline-block h-0.5 w-6 bg-brand" aria-hidden="true"></span>{t(lang, 'heroEyebrow')}</p>
          <h1 class="mt-3 text-3xl font-bold tracking-tight text-balance md:text-5xl">{t(lang, 'heroTitle')}</h1>
          <p class="mt-4 max-w-xl text-lg text-graphite">{t(lang, 'heroBody')}</p>
          <p class="mt-3 font-display text-xl tracking-wide text-ink">{pick(company.slogan, lang)}</p>
        </div>
        <QuoteStrip lang={lang} variant="compact" />
      </div>
      <div class="self-start"><ResultsHubCard period={period} lang={lang} feature headingLevel="h2" /></div>
    </div>
  </section>

  <!-- Why Invest (client deck slide 9; draft) -->
  <WhyInvest lang={lang} />

  <!-- Latest announcements -->
  <section class="container-page border-t border-mist py-section" aria-labelledby="h-ann">
    <SectionHeading id="h-ann" title={t(lang, 'latestAnnouncements')} action={{ href: href('investors/announcements/'), label: t(lang, 'allAnnouncements') }} />
    <div class="border-t border-ink">
      {announcements.map((d) => <DocumentRow doc={d} lang={lang} headingLevel="h3" />)}
    </div>
  </section>

  <!-- Financial highlights -->
  <section class="bg-paper py-section" aria-labelledby="h-fin">
    <div class="container-page">
      <SectionHeading id="h-fin" title={t(lang, 'financialHighlights')} description={`${t(lang, 'fy')}${lang === 'en' ? ' ' : ''}${highlights.years[0]} · ${pick(highlights.currencyNote, lang)}`} action={{ href: href('investors/highlights/'), label: t(lang, 'allHighlights') }} />
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {kpis.map((r) => <KpiCard row={r} years={highlights.years} lang={lang} label={kpiLabels[r.key]?.[lang]} />)}
      </div>
    </div>
  </section>

  <!-- Events + contact -->
  <section class="container-page grid gap-12 py-section lg:grid-cols-[1.4fr_1fr]">
    <div aria-labelledby="h-ev">
      <SectionHeading id="h-ev" title={upcoming.length ? t(lang, 'upcomingEvents') : t(lang, 'recentEvents')} action={{ href: href('investors/'), label: t(lang, 'irCalendar') }} />
      {!upcoming.length && <p class="mb-2 text-sm text-graphite">{t(lang, 'noUpcoming')}</p>}
      <div class="border-t border-ink">
        {(upcoming.length ? upcoming : recent).map((e) => <CalendarItem event={e} lang={lang} past={!upcoming.length} />)}
      </div>
    </div>
    <div aria-labelledby="h-cta" class="flex flex-col gap-4">
      <SectionHeading id="h-cta" title={t(lang, 'stayInformed')} description={t(lang, 'stayInformedBody')} />
      <div class="flex flex-wrap gap-3">
        <Button href={alertUrl} external icon="bell" srSuffix={t(lang, 'externalSite')}>{t(lang, 'emailAlerts')}</Button>
        <Button href={href('contact/')} variant="secondary">{t(lang, 'contactIr')}</Button>
      </div>
      <ContactCard lang={lang} title={pick(hk.name, lang)} address={pick(hk.address, lang)} phones={hk.phones} fax={hk.fax} emails={irEmails} />
    </div>
  </section>

  <!-- Brands -->
  <section class="border-t border-mist py-section" aria-labelledby="h-br">
    <div class="container-page">
      <SectionHeading id="h-br" title={t(lang, 'ourBrands')} action={{ href: href('brands/'), label: t(lang, 'brandPortfolio') }} />
      <BrandStrip lang={lang} />
    </div>
  </section>

  <!-- ESG teaser -->
  <section class="on-dark bg-ink text-white" aria-labelledby="h-esg">
    <div class="container-page grid items-center gap-8 py-section md:grid-cols-2">
      <div>
        <p class="text-xs font-semibold tracking-wider text-[#d6d3ce] uppercase">ESG</p>
        <h2 id="h-esg" class="mt-2 text-2xl font-bold md:text-3xl">{t(lang, 'esgTitle')}</h2>
        <p class="mt-3 max-w-lg text-[#e8e5e0]">{t(lang, 'esgBody')}</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <Button href={esgUrl} variant="inverse" external srSuffix={t(lang, 'externalSite')}>{t(lang, 'visitEsg')}</Button>
          <Button href={esgReports} variant="inverse" external srSuffix={t(lang, 'externalSite')}>{t(lang, 'esgReports')}</Button>
        </div>
      </div>
      <Image src={esgImage} alt="" widths={[480, 768, 1080]} sizes="(min-width: 768px) 50vw, 100vw" class="aspect-[5/3] w-full rounded-card object-cover" loading="lazy" />
    </div>
  </section>
</Base>
