---
// Static redirect to the default language (no server needed); respects PREVIEW_BASE.
import { withBase } from '../lib/paths';
const target = withBase('en/');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <title>ANTA Sports IR — Preview</title>
  </head>
  <body>
    <p>PREVIEW — not the official ANTA Sports website.</p>
    <a href={target}>English</a> · <a href={withBase('tc/')}>繁體中文</a> · <a href={withBase('sc/')}>简体中文</a>
  </body>
</html>
