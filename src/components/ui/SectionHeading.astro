---
/** Section heading: optional eyebrow, title (h2 by default), description and a trailing action link. */
import Icon from './Icon.astro';
interface Props {
  title: string;
  id?: string;
  eyebrow?: string;
  description?: string;
  level?: 2 | 3;
  action?: { href: string; label: string };
  class?: string;
}
const { title, id, eyebrow, description, level = 2, action, class: cls = '' } = Astro.props;
const H = `h${level}` as 'h2' | 'h3';
---
<div class={`mb-7 flex flex-wrap items-end justify-between gap-x-6 gap-y-3 lg:mb-11 ${cls}`}>
  <div class="max-w-3xl">
    {eyebrow && <p class="eyebrow ll-eyebrow mb-2.5">{eyebrow}</p>}
    <H id={id} class={level === 2 ? 'text-3xl font-[650] tracking-[-0.022em] text-balance lg:text-4xl' : 'text-xl font-semibold'}>{title}</H>
    {description && <p class="mt-2 text-sm text-muted">{description}</p>}
  </div>
  {action && (
    <a href={action.href} class="ll-arrow inline-flex min-h-11 items-center gap-2 text-[0.9375rem] font-semibold text-brand-ink underline-offset-4 hover:underline">
      {action.label}<Icon name="arrow-right" size={16} />
    </a>
  )}
</div>
