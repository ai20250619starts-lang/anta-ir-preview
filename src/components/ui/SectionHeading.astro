---
/** Section heading: optional eyebrow, title (h2 by default), description and a trailing action link. */
import Icon from './Icon.astro';
interface Props {
  title: string;
  id?: string;
  eyebrow?: string;
  description?: string;
  level?: 2 | 3;
  action?: { href: string; label: string };
  class?: string;
}
const { title, id, eyebrow, description, level = 2, action, class: cls = '' } = Astro.props;
const H = `h${level}` as 'h2' | 'h3';
---
<div class={`mb-6 flex flex-wrap items-end justify-between gap-x-6 gap-y-3 ${cls}`}>
  <div class="max-w-3xl">
    {eyebrow && <p class="eyebrow mb-2 flex items-center gap-2"><span class="inline-block h-0.5 w-6 bg-brand" aria-hidden="true"></span>{eyebrow}</p>}
    <H id={id} class={level === 2 ? 'text-2xl font-bold tracking-tight md:text-3xl' : 'text-xl font-semibold'}>{title}</H>
    {description && <p class="mt-2 text-graphite">{description}</p>}
  </div>
  {action && (
    <a href={action.href} class="inline-flex min-h-11 items-center gap-1.5 text-sm font-semibold text-brand-ink underline decoration-1 underline-offset-4 hover:decoration-2">
      {action.label}<Icon name="arrow-right" size={14} />
    </a>
  )}
</div>
