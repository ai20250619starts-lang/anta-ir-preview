---
/**
 * Button / button-styled link.
 * Lane Lines pills (DESIGN.md §3 "Buttons"): 48px high, 22px padding, 15px/600.
 *  primary   — white on text-safe brand red (brand-ink); hover brand-press
 *  ink       — white on ink
 *  secondary — 1.5px ink outline; hover fills ink
 *  inverse   — outline for dark backgrounds
 *  text      — red text link; arrow nudges 3px on hover
 */
import Icon from './Icon.astro';
interface Props {
  href?: string;
  variant?: 'primary' | 'ink' | 'secondary' | 'inverse' | 'text';
  size?: 'sm' | 'md';
  external?: boolean;
  icon?: 'arrow-right' | 'external' | 'file' | 'mail' | 'bell' | 'play' | 'calendar' | null;
  srSuffix?: string;
  class?: string;
  type?: 'button' | 'submit';
  [k: string]: unknown;
}
const { href, variant = 'primary', size = 'md', external = false, icon = external ? 'external' : 'arrow-right', srSuffix, class: cls = '', type = 'button', ...rest } = Astro.props;
const base = 'll-arrow ll-press inline-flex items-center justify-center gap-2.5 font-semibold leading-none transition-colors duration-200 no-underline';
const sizes = { sm: 'min-h-10 px-4 text-sm', md: 'min-h-12 px-[22px] text-[0.9375rem]' } as const;
const variants = {
  primary: 'rounded-full bg-brand-ink text-white hover:bg-brand-press',
  ink: 'rounded-full bg-ink text-white hover:bg-graphite',
  secondary: 'rounded-full border-[1.5px] border-ink text-ink hover:bg-ink hover:text-white',
  inverse: 'rounded-full border-[1.5px] border-white/60 text-white hover:border-white hover:bg-white hover:text-ink on-dark',
  text: 'text-brand-ink hover:underline underline-offset-4 !px-0 !min-h-11',
} as const;
const classes = `${base} ${sizes[size]} ${variants[variant]} ${cls}`;
---
{href ? (
  <a href={href} class={classes} {...(external ? { rel: 'noopener' } : {})} {...rest}>
    <span><slot /></span>{srSuffix && <span class="sr-only"> ({srSuffix})</span>}
    {icon && <Icon name={icon} size={variant === 'text' ? 14 : 16} />}
  </a>
) : (
  <button type={type} class={classes} {...rest}>
    <span><slot /></span>
    {icon && <Icon name={icon} />}
  </button>
)}
