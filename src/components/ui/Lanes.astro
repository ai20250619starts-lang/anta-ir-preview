---
/**
 * "Lane lines": running-track bend used as the hero texture (port of lanes() in design/src/build.py).
 * Two layers with identical geometry so they can move independently (MOTION.md §3/§5): the grey hairlines
 * (.ll-hero-lanes) and the red lead lane (.ll-lead-lane), which draws in via stroke-dashoffset on a
 * pathLength=1 path. Decorative only.
 */
interface Props { n?: number; cx?: number; cy?: number; r0?: number; gap?: number; lead?: number; w?: number; h?: number; class?: string }
const { n = 9, cx = 480, cy = 1010, r0 = 120, gap = 36, lead = 4, w = 1440, h = 890, class: cls = '' } = Astro.props;
const paths = Array.from({ length: n }, (_, i) => {
  const r = r0 + i * gap;
  return { d: `M${w},${cy - r} H${cx} A${r},${r} 0 0 0 ${cx},${cy + r}`, lead: i === lead };
});
---
<svg class={`ll-hero-lanes ${cls}`} viewBox={`0 0 ${w} ${h}`} preserveAspectRatio="xMinYMax slice" aria-hidden="true" focusable="false">
  {paths.filter((p) => !p.lead).map((p) => <path d={p.d} />)}
</svg>
<svg class={`ll-lead-lane ${cls}`} viewBox={`0 0 ${w} ${h}`} preserveAspectRatio="xMinYMax slice" aria-hidden="true" focusable="false">
  {paths.filter((p) => p.lead).map((p) => <path pathLength="1" d={p.d} />)}
</svg>
