---
interface Props {
  tone?: 'neutral' | 'brand' | 'dark' | 'outline' | 'notice';
  class?: string;
}
const { tone = 'neutral', class: cls = '' } = Astro.props;
const tones = {
  neutral: 'bg-surface text-ink',
  brand: 'bg-brand-tint text-brand-ink',
  dark: 'bg-ink text-white',
  outline: 'border border-line text-graphite',
  notice: 'bg-[#ffd84d] text-ink', /* "illustrative" marker: high-visibility amber, 13:1 with ink */
} as const;
---
<span class={`inline-flex min-h-[22px] items-center gap-1 rounded-sm px-2 py-0.5 text-2xs leading-none font-semibold tracking-[0.06em] uppercase ${tones[tone]} ${cls}`}><slot /></span>
