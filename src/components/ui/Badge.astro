---
interface Props {
  tone?: 'neutral' | 'brand' | 'dark' | 'outline' | 'notice';
  class?: string;
}
const { tone = 'neutral', class: cls = '' } = Astro.props;
const tones = {
  neutral: 'bg-sand text-ink',
  brand: 'bg-brand-tint text-brand-ink',
  dark: 'bg-ink text-white',
  outline: 'border border-mist text-graphite',
  notice: 'bg-[#ffd84d] text-ink', /* "illustrative" marker: high-visibility amber, 13:1 with ink */
} as const;
---
<span class={`inline-flex items-center gap-1 rounded-sm px-1.5 py-0.5 text-2xs font-semibold tracking-wide uppercase ${tones[tone]} ${cls}`}><slot /></span>
