---
/**
 * Stock quote card (Lane Lines "Stock quote card") using the MOCK quote (data/quote.mock.json).
 * Always labelled "Illustrative" (flag bar) and carries the explicit ≥15-minute delay + as-of time in HKT.
 * Direction = arrow + sign + %, colour only as a secondary cue. Sparkline draws in on load (CSS, see global.css).
 */
import type { Lang } from '../data/schemas';
import { quote } from '../data';
import { t } from '../i18n/ui';
import { formatDate, formatMonth } from '../lib/format';
import { withBase } from '../lib/paths';
import Change from './ui/Change.astro';
import Icon from './ui/Icon.astro';

interface Props { lang: Lang; variant?: 'full' | 'compact'; class?: string }
const { lang, class: cls = '' } = Astro.props;
const q = quote;
const asOfDate = q.asOf.slice(0, 10);
const asOfTime = q.asOf.slice(11, 16);
// sparkline (fixed aspect ratio → no distortion, no layout shift)
const closes = q.series.map((p) => p.close);
const min = Math.min(...closes), max = Math.max(...closes);
const W = 400, H = 84, PAD = 6;
const xy = closes.map((c, i) => [(i / (closes.length - 1)) * (W - PAD), PAD + (1 - (c - min) / (max - min || 1)) * (H - 2 * PAD)] as const);
const line = xy.map(([x, y], i) => `${i ? 'L' : 'M'}${x.toFixed(1)},${y.toFixed(1)}`).join('');
const area = `${line}L${(W - PAD).toFixed(1)},${H}L0,${H}Z`;
const [lx, ly] = xy[xy.length - 1];
const first = q.series[0]?.date ?? '';
const last = q.series[q.series.length - 1]?.date ?? asOfDate;
// compact market figures: M/B in EN, 萬/億 in Chinese
const compact = (n: number) =>
  lang === 'en' ? (n >= 1e9 ? `${(n / 1e9).toFixed(2)}B` : `${(n / 1e6).toFixed(2)}M`) : n >= 1e8 ? `${(n / 1e8).toFixed(2)}${lang === 'tc' ? '億' : '亿'}` : `${(n / 1e4).toFixed(2)}${lang === 'tc' ? '萬' : '万'}`;
const stats: [string, string][] = [
  [t(lang, 'open'), q.open.toFixed(2)],
  [t(lang, 'prevClose'), q.prevClose.toFixed(2)],
  [t(lang, 'high'), q.high.toFixed(2)],
  [t(lang, 'low'), q.low.toFixed(2)],
  [t(lang, 'volume'), compact(q.volume)],
  [t(lang, 'turnover'), compact(q.turnover)],
];
const pos = ((q.last - q.week52Low) / (q.week52High - q.week52Low || 1)) * 100;
const label = { en: 'Share price (illustrative)', tc: '股價（示意）', sc: '股价（示意）' }[lang];
---
<section aria-label={label} class={`overflow-hidden rounded-lg bg-white text-ink shadow-raised ${cls}`}>
  <p class="flex items-center gap-2.5 border-b border-[#f0e2a0] bg-flag-tint px-5 py-2.5 text-[0.8125rem] leading-[1.125rem] lg:px-6">
    <span class="inline-flex h-[22px] items-center rounded-sm bg-flag px-2 text-2xs font-bold tracking-[0.08em] uppercase">{t(lang, 'illustrative')}</span>
    <span>{t(lang, 'illustrativeLong')}</span>
  </p>
  <div class="p-5 lg:p-6">
    <p class="text-[0.8125rem] font-medium text-muted"><b class="text-ink">{q.symbol}</b> · ANTA Sports · HKD</p>
    <p class="mt-0.5 flex flex-wrap items-baseline gap-x-3.5 gap-y-1.5">
      <span class="display-num text-[4rem] leading-none tracking-[-0.01em] lg:text-num-xl">{q.last.toFixed(2)}</span>
      <Change value={q.changePct} abs={q.change} unit="%" lang={lang} digits={2} class="ll-chg-in text-[1.0625rem]" />
    </p>
    <svg viewBox={`0 0 ${W} ${H}`} class="ll-spark mt-3.5 block h-auto w-full" aria-hidden="true" focusable="false">
      <path class="ll-spark-area" d={area} fill="rgb(14 15 17 / 0.05)" />
      <path class="ll-spark-line" d={line} fill="none" stroke="var(--color-ink)" stroke-width="1.5" stroke-linejoin="round" />
      <rect class="ll-spark-wipe" x="0" y="0" width={W} height={H} fill="#fff" />
      <circle class="ll-spark-ring" cx={lx} cy={ly} r="7" fill="none" stroke="var(--color-muted)" stroke-width="1.5" />
      <circle class="ll-spark-dot" cx={lx} cy={ly} r="4.5" fill="var(--color-brand)" stroke="rgb(255 0 0 / 0.18)" stroke-width="6" />
    </svg>
    <p class="mt-1.5 flex justify-between text-2xs text-muted" aria-hidden="true"><span>{formatMonth(first, lang)}</span><span>{t(lang, 'sparkCaption')}</span><span>{formatMonth(last, lang)}</span></p>
    <dl class="tabular mt-4 grid grid-cols-2 gap-x-5 border-t border-line text-[0.8125rem]">
      {stats.map(([k, v]) => (
        <div class="flex justify-between gap-2 border-b border-line py-2"><dt class="text-muted">{k}</dt><dd class="font-semibold">{v}</dd></div>
      ))}
      <div class="col-span-2 pt-2">
        <dt class="text-muted">{t(lang, 'week52')}</dt>
        <dd>
          <div class="relative mt-2.5 mb-1.5 h-1 rounded bg-line" aria-hidden="true"><i class="absolute -top-1 h-3 w-[3px] rounded-sm bg-ink" style={`left:calc(${pos.toFixed(1)}% - 1.5px)`}></i></div>
          <div class="flex justify-between font-semibold"><span><span class="sr-only">{t(lang, 'low')} </span>{q.week52Low.toFixed(2)}</span><span><span class="sr-only">{t(lang, 'high')} </span>{q.week52High.toFixed(2)}</span></div>
        </dd>
      </div>
    </dl>
  </div>
  <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 border-t border-line bg-[#fbfbfc] px-5 py-1.5 lg:px-6">
    <p class="flex items-center gap-2 text-xs text-graphite">
      <Icon name="clock" size={14} />
      <span><b class="text-ink">{t(lang, 'delayed15')}</b> · {t(lang, 'asOf')} <time datetime={q.asOf} class="tabular">{formatDate(asOfDate, lang)} {asOfTime} {t(lang, 'hkt')}</time></span>
    </p>
    <a href={withBase(`${lang}/investors/stock/`)} class="ll-arrow inline-flex min-h-11 items-center gap-2 text-[0.9375rem] font-semibold text-brand-ink hover:underline underline-offset-4">{t(lang, 'quoteDetails')}<Icon name="arrow-right" size={16} /></a>
  </div>
</section>
