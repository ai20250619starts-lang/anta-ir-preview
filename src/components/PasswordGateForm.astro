---
// Overlay shown while the light password gate is locked (see PasswordGate.astro). Rendered only when PREVIEW_PASSWORD is set.
const enabled = !!process.env.PREVIEW_PASSWORD;
---
{enabled && (
  <div id="pg-gate" class="fixed inset-0 z-50 items-center justify-center bg-white p-6" role="dialog" aria-modal="true" aria-labelledby="pg-title">
    <form class="w-full max-w-sm" onsubmit="return window.__pgCheck(event)">
      <h2 id="pg-title" class="text-lg font-semibold">ANTA Sports IR — client preview</h2>
      <p class="mt-1 text-sm text-graphite">Enter the preview password · 請輸入預覽密碼 · 请输入预览密码</p>
      <label for="pg-input" class="sr-only">Password</label>
      <input id="pg-input" type="password" autocomplete="current-password" required class="mt-4 w-full rounded border border-mist px-3 py-2" />
      <p id="pg-error" hidden class="mt-2 text-sm text-brand-ink">Incorrect password.</p>
      <button type="submit" class="mt-4 w-full rounded bg-ink px-3 py-2 text-white">Enter</button>
    </form>
  </div>
)}
