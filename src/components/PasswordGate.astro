---
/**
 * LIGHT client-side password gate for the client preview. NOT real security: the HTML is still publicly downloadable,
 * and anyone can view source or disable JavaScript. It only keeps casual visitors and link-forwarders out.
 * Enabled when PREVIEW_PASSWORD is set at build time; only a salted SHA-256 hash is embedded in the pages.
 */
import { createHash } from 'node:crypto';
const password = process.env.PREVIEW_PASSWORD ?? '';
const salt = 'anta-ir-preview:v1:';
const hash = password ? createHash('sha256').update(salt + password).digest('hex') : '';
---
{hash && (
  <>
    <style is:inline>{`html.pg-locked body > *:not(#pg-gate){display:none!important} #pg-gate{display:none} html.pg-locked #pg-gate{display:flex}`}</style>
    <script is:inline define:vars={{ hash, salt }}>
      try { if (sessionStorage.getItem('pg-ok') !== hash) document.documentElement.classList.add('pg-locked'); } catch (e) { document.documentElement.classList.add('pg-locked'); }
      window.__pgCheck = async function (ev) {
        ev.preventDefault();
        var input = document.getElementById('pg-input');
        var data = new TextEncoder().encode(salt + input.value);
        var buf = await crypto.subtle.digest('SHA-256', data);
        var hex = Array.from(new Uint8Array(buf)).map(function (b) { return b.toString(16).padStart(2, '0'); }).join('');
        if (hex === hash) { try { sessionStorage.setItem('pg-ok', hash); } catch (e) {} document.documentElement.classList.remove('pg-locked'); }
        else { document.getElementById('pg-error').hidden = false; input.select(); }
        return false;
      };
    </script>
  </>
)}
