---
/**
 * Results-period hub (Lane Lines "Results band"): head (period, date, tag, results centre) + five document tiles
 * (report, presentation, webcast, announcement, press release). 4px brand top edge = where the hero's red lane arrives.
 * Keeps the 繁體版 / EN version note when the linked file is in another language.
 */
import type { Lang } from '../data/schemas';
import { HTML_LANG, t } from '../i18n/ui';
import { formatDate } from '../lib/format';
import { primaryFile, formatLabel } from '../lib/docs';
import { periodLabel, type ResultsPeriod, type SlotKey } from '../lib/results';
import { withBase } from '../lib/paths';
import { formatBytes } from '../data';
import Icon from './ui/Icon.astro';
import Badge from './ui/Badge.astro';

interface Props { period: ResultsPeriod; lang: Lang; feature?: boolean; headingLevel?: 'h2' | 'h3' }
const { period, lang, feature = false, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
const slots: { key: SlotKey; label: string; icon: 'file' | 'play' }[] = [
  { key: 'report', label: t(lang, 'report'), icon: 'file' },
  { key: 'presentation', label: t(lang, 'presentation'), icon: 'file' },
  { key: 'webcast', label: t(lang, 'webcast'), icon: 'play' },
  { key: 'announcement', label: t(lang, 'announcement'), icon: 'file' },
  { key: 'pressRelease', label: t(lang, 'pressRelease'), icon: 'file' },
];
const reportTitle = period.half === 'annual' ? { en: 'Annual report', tc: '年報', sc: '年报' }[lang] : { en: 'Interim report', tc: '中期報告', sc: '中期报告' }[lang];
---
<article class={`relative grid overflow-hidden rounded-lg bg-white pt-1 shadow-raised ${feature ? 'lg:grid-cols-[300px_1fr]' : ''}`}>
  <span class={`ll-edge ${feature ? 'll-edge-in' : ''}`} aria-hidden="true"></span>
  <div class={`flex flex-col gap-1.5 p-6 ${feature ? 'lg:border-r lg:border-line lg:p-8' : ''}`}>
    <p class="eyebrow">{t(lang, 'latestResults')}</p>
    <H class="text-2xl font-[650] tracking-[-0.02em]">{periodLabel(period, lang)}</H>
    <p class="text-sm text-graphite">
      {period.date && <>{t(lang, 'announcedOn')}{lang === 'en' ? ' ' : '：'}<time datetime={period.date}>{formatDate(period.date, lang)}</time> · </>}
      <span class="font-display text-[0.9375rem] font-semibold tracking-[0.06em] text-brand-ink">{period.half === 'annual' ? 'FY' : '1H'}{String(period.fy).slice(2)}</span>
    </p>
    <p class={`mt-2.5 ${feature ? 'lg:mt-auto lg:pt-3' : ''}`}>
      <a href={withBase(`${lang}/investors/reports/`)} class="ll-arrow inline-flex min-h-11 items-center gap-2 text-[0.9375rem] font-semibold text-brand-ink underline-offset-4 hover:underline">{t(lang, 'resultsCentre')}<Icon name="arrow-right" size={16} /></a>
    </p>
  </div>
  <ul class={`grid border-t border-line sm:grid-cols-2 ${feature ? 'lg:grid-cols-5 lg:border-t-0' : ''}`}>
    {slots.map((s, i) => {
      const d = period.docs[s.key];
      const pf = d ? primaryFile(d, lang) : null;
      const label = s.key === 'report' ? reportTitle : s.label;
      const note = pf?.isFallback ? t(lang, pf.versionLang === 'tc' ? 'tcVersion' : pf.versionLang === 'en' ? 'enVersion' : 'scVersion') : null;
      const tile = `flex h-full min-h-16 items-center gap-3.5 px-6 py-4 ${feature ? 'lg:flex-col lg:items-start lg:gap-5 lg:py-8' : ''}`;
      return (
        <li class={`border-b border-line sm:odd:border-r ${feature ? 'lg:border-r lg:border-b-0 lg:last:border-r-0' : ''}`}>
          {pf && d ? (
            <a href={pf.file.url} rel="noopener" class={`group ll-card ll-flat hover:bg-surface ${feature ? 'll-tile-in' : ''} ${tile}`} style={`--i:${i}`}>
              <span class="ll-well grid size-10 shrink-0 place-items-center rounded-md bg-surface text-ink transition-colors duration-200 group-hover:bg-ink group-hover:text-white"><Icon name={s.icon} size={20} /></span>
              <span class="min-w-0">
                <span class="block text-[0.9375rem] leading-5 font-semibold">{label}</span>
                <span class="tabular block text-xs text-muted">{formatLabel(pf.file, d.type, lang)}{pf.file.sizeBytes ? ` · ${formatBytes(pf.file.sizeBytes)}` : ''}</span>
                {note && <span lang={HTML_LANG[pf.versionLang]} class="mt-1 inline-block"><Badge tone="brand">{note}</Badge></span>}
              </span>
            </a>
          ) : (
            <span class={`text-graphite ${feature ? 'll-tile-in' : ''} ${tile}`} style={`--i:${i}`}>
              <span class="ll-well grid size-10 shrink-0 place-items-center rounded-md bg-surface text-muted"><Icon name={s.icon} size={20} /></span>
              <span><span class="block text-[0.9375rem] leading-5 font-semibold">{label}</span><span class="block text-xs">{t(lang, 'notYetAvailable')}</span></span>
            </span>
          )}
        </li>
      );
    })}
  </ul>
</article>
