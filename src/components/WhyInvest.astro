---
/** "Why Invest" points (client deck slide 9). Content + sources live in src/data/why-invest.ts. */
import type { Lang } from '../data/schemas';
import { WHY_INVEST, type WhyInvestPoint } from '../data/why-invest';
import { t } from '../i18n/ui';
import Badge from './ui/Badge.astro';
import Icon from './ui/Icon.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
/** Link each point to its primary public source on ir.anta.com, in the reader's language. */
const sourceUrl = (p: WhyInvestPoint): string => {
  const src = p.facts[0].source;
  if (src.kind === 'document') return src.url.replace('/en/', `/${lang}/`);
  return `https://ir.anta.com/${lang}/${src.file === 'data/brands.json' ? 'brand.php' : 'about_ir.php'}`;
};
---
<section class="container-page py-section" aria-labelledby="h-why">
  <div class="mb-6 flex flex-wrap items-center gap-x-4 gap-y-2">
    <h2 id="h-why" class="text-2xl font-bold tracking-tight md:text-3xl">{t(lang, 'whyInvest')}</h2>
    <Badge tone="notice">{t(lang, 'draftBadge')}</Badge>
  </div>
  <ol class="grid gap-px overflow-hidden rounded-card border border-mist bg-mist sm:grid-cols-2 lg:grid-cols-5">
    {WHY_INVEST.map((p, i) => (
      <li class="flex flex-col gap-2 bg-white p-5">
        <span class="display-num text-3xl text-brand-ink" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        <h3 class="text-base font-semibold">{p.title[lang]}</h3>
        <p class="text-sm text-graphite">{p.body[lang]}</p>
        <a href={sourceUrl(p)} rel="noopener" class="mt-auto inline-flex min-h-8 items-center gap-1 pt-2 text-xs text-stone underline underline-offset-2 hover:text-ink">
          {t(lang, 'source')}<Icon name="external" size={12} /><span class="sr-only"> ({t(lang, 'externalSite')})</span>
        </a>
      </li>
    ))}
  </ol>
  <p class="mt-3 text-xs text-stone">{t(lang, 'whyInvestNote')}</p>
</section>
