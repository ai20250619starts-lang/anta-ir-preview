---
/**
 * "Why Invest" (client deck slide 9; client-confirmed). Lane Lines split layout: sticky intro + ordered list.
 * Each point leads with a figure taken from its own copy (src/data/why-invest.ts, tested) behind a red lane rule;
 * figures count up once in view (CountUp). Content + sources live in src/data/why-invest.ts.
 */
import type { Lang } from '../data/schemas';
import { WHY_INVEST, type WhyInvestPoint } from '../data/why-invest';
import { t } from '../i18n/ui';
import { withBase } from '../lib/paths';
import Icon from './ui/Icon.astro';
import CountUp from './ui/CountUp.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
/** Link each point to its primary public source on ir.anta.com, in the reader's language. */
const sourceUrl = (p: WhyInvestPoint): string => {
  const src = p.facts[0].source;
  if (src.kind === 'document') return src.url.replace('/en/', `/${lang}/`);
  return `https://ir.anta.com/${lang}/${src.file === 'data/brands.json' ? 'brand.php' : 'about_ir.php'}`;
};
---
<section id="why" class="py-section lg:py-section-lg" aria-labelledby="h-why" data-reveal>
  <div class="container-page grid gap-8 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-16">
    <div class="lg:sticky lg:top-32 lg:self-start">
      <p class="eyebrow ll-eyebrow ll-eb">{t(lang, 'investmentCase')}</p>
      <h2 id="h-why" data-enter style="--i:1" class="mt-3 text-3xl font-[650] tracking-[-0.022em] text-balance lg:text-4xl">{t(lang, 'whyInvest')}</h2>
      <p class="mt-5 max-w-[28em] text-sm text-muted">{t(lang, 'whyInvestNote')}</p>
      <p class="mt-5"><a href={withBase(`${lang}/investors/`)} class="ll-arrow inline-flex min-h-11 items-center gap-2 text-[0.9375rem] font-semibold text-brand-ink underline-offset-4 hover:underline">{t(lang, 'irOverview')}<Icon name="arrow-right" size={16} /></a></p>
    </div>
    <div class="ll-why-list">
    <span class="ll-why-rail" aria-hidden="true"></span>
    <ol class="border-t-2 border-ink">
      {WHY_INVEST.map((p, i) => (
        <li class="grid grid-cols-[44px_1fr] gap-x-3 gap-y-1 border-b border-line py-7 lg:grid-cols-[56px_minmax(0,1fr)_220px] lg:gap-x-8 lg:py-8">
          <span data-enter style="--kf:ll-slide-sm" class="font-display text-lg leading-7 font-semibold tracking-[0.04em] text-brand-ink" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div data-enter style="--i:1">
            <h3 class="text-xl font-[650] tracking-[-0.01em]">{p.title[lang]}</h3>
            <p class="mt-2 max-w-[38em] text-[0.9375rem] leading-6 text-graphite">{p.body[lang]}</p>
            <a href={sourceUrl(p)} rel="noopener" class="mt-2.5 inline-flex min-h-8 items-center gap-1.5 text-[0.8125rem] text-muted underline underline-offset-[3px] hover:text-ink">
              {t(lang, 'source')}<Icon name="external" size={12} /><span class="sr-only"> ({t(lang, 'externalSite')})</span>
            </a>
          </div>
          <p data-enter style="--i:2;--kf:ll-surge" class="ll-fig col-start-2 mt-4 lg:col-start-3 lg:row-span-2 lg:row-start-1 lg:mt-0 lg:self-start">
            <CountUp value={p.figure[lang]} class="display-num block text-num-md leading-none lg:text-num-lg" />
            <span class="mt-1.5 block max-w-[16em] text-[0.8125rem] leading-[1.125rem] text-muted">{p.figureCaption[lang]}</span>
          </p>
        </li>
      ))}
    </ol>
    </div>
  </div>
</section>
