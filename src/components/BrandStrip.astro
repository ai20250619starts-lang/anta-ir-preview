---
/**
 * Monochrome logo strip of the brand portfolio (logos rendered black for a calm, consistent row).
 * In-house brands follow the client's order (deck slide 4). Strategic investments are only those listed on
 * ir.anta.com/en/brand.php (data/brands.json): Amer Sports and MUSINSA. Brands matching src/lib/hidden-terms.ts
 * are never shown.
 * All eight have local logo assets; a text wordmark is the fallback if one is missing.
 */
import type { Lang } from '../data/schemas';
import { brands } from '../data';
import { t } from '../i18n/ui';
import { localImage } from '../lib/images';
import { withBase } from '../lib/paths';
import { Image } from 'astro:assets';

interface Props { lang: Lang }
const { lang } = Astro.props;
const CLIENT_ORDER = ['anta', 'fila', 'descente', 'kolon-sport', 'jack-wolfskin', 'maia-active', 'amer', 'musinsa'];
const rank = (k: string) => (CLIENT_ORDER.includes(k) ? CLIENT_ORDER.indexOf(k) : 100);
const list = [...brands.brands].sort((a, b) => rank(a.key) - rank(b.key) || a.order - b.order);
const brandHref = (b: (typeof list)[number]) =>
  withBase(b.pillar === 'in-house' ? `${lang}/brands/${b.key}/` : `${lang}/brands/strategic-investments/#${b.key}`);
/** Display names where the logo alone is ambiguous (AMER = Amer Sports, per brand.php). */
const NAMES: Record<string, string> = { amer: 'Amer Sports' };
/**
 * Optical size corrections so logos read at a similar visual weight. AMER's file has wide transparent padding
 * and small lettering; MUSINSA is a very wide, heavy wordmark (240x47). Default: 48px tall.
 */
const LOGO_SIZE: Record<string, { h: number; cls: string }> = {
  'kolon-sport': { h: 58, cls: 'max-h-[58px]' },
  'maia-active': { h: 58, cls: 'max-h-[58px]' },
  amer: { h: 64, cls: 'max-h-16' },
  musinsa: { h: 22, cls: 'max-h-[22px] max-w-[120px]' },
};
/** One line per strategic investment: the first sentence of the relationship paragraph in brands.json. */
const relation = (b: (typeof list)[number]) => {
  const paras = (b.description as Record<Lang, string[] | null>)[lang] ?? b.description.en ?? [];
  const txt = paras[1] ?? paras[0] ?? '';
  const m = txt.match(lang === 'en' ? /^.*?\.(?=\s|$)/ : /^.*?。/);
  return (m ? m[0] : txt).trim();
};
const inHouse = list.filter((b) => b.pillar === 'in-house');
const strategic = list.filter((b) => b.pillar === 'strategic-investment');
---
<div>
  <div class="mb-3.5 flex items-center justify-between gap-4">
    <h3 class="eyebrow">{t(lang, 'inHouse')}</h3>
  </div>
  <ul class="grid grid-cols-2 gap-3 md:grid-cols-3 xl:grid-cols-6">
    {inHouse.map((b, i) => {
      const img = localImage(b.logo?.src);
      const size = LOGO_SIZE[b.key] ?? { h: 44, cls: 'max-h-11' };
      return (
        <li>
          <a href={brandHref(b)} data-enter style={`--i:${i}`} class="ll-card relative grid h-[116px] place-items-center rounded-lg border border-line bg-white xl:h-[140px]">
            {img ? (
              <Image src={img} alt={NAMES[b.key] ?? b.name} height={size.h} class={`ll-logo ${size.cls} w-auto max-w-[62%] object-contain brightness-0`} />
            ) : (
              <span class="font-display text-xl tracking-wide">{b.name}</span>
            )}
            <span class="ll-cap absolute bottom-2.5 left-3.5 text-2xs font-semibold tracking-[0.06em] text-muted uppercase" aria-hidden="true">{NAMES[b.key] ?? b.name}</span>
          </a>
        </li>
      );
    })}
  </ul>
  <div class="relative h-0.5 overflow-clip" aria-hidden="true"><span class="ll-shimmer h-full w-full bg-brand"></span></div>
  {strategic.length > 0 && (
    <>
      <h3 class="eyebrow mt-10 mb-3.5">{t(lang, 'strategic')}</h3>
      <ul class="grid gap-3 md:grid-cols-2">
        {strategic.map((b, i) => {
          const img = localImage(b.logo?.src);
          const size = LOGO_SIZE[b.key] ?? { h: 48, cls: 'max-h-12' };
          return (
            <li>
              <a href={brandHref(b)} data-enter style={`--i:${i + 3};--kf:ll-slide-r;--from-x:32px`} class="ll-card grid h-full grid-cols-[88px_1fr] items-center gap-5 rounded-lg border border-line bg-white px-6 py-5 md:grid-cols-[128px_1fr]">
                <span class="grid place-items-center">{img ? <Image src={img} alt="" height={size.h} class={`ll-logo ${size.cls} w-auto object-contain brightness-0`} /> : <span class="font-display text-lg">{b.name}</span>}</span>
                <span>
                  <b class="block text-base font-[650]">{NAMES[b.key] ?? b.name}</b>
                  <span class="mt-0.5 block text-sm leading-[1.3125rem] text-graphite">{relation(b)}</span>
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </>
  )}
</div>
